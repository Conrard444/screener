#!/usr/bin/env bash
# Git pre-commit hook: draait de volledige kwaliteitscontrole v\u00f3\u00f3r elke commit.
# Installatie: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
cd "$(git rev-parse --show-toplevel)"
if [ -f scripts/check-all.sh ]; then
  ./scripts/check-all.sh || {
    echo ""
    echo "COMMIT GEWEIGERD: de kwaliteitscontrole faalde."
    echo "Los de fouten hierboven op en probeer opnieuw."
    exit 1
  }
fi
