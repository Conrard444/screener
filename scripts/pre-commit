#!/usr/bin/env bash
# Git pre-commit hook: blokkeert commits met syntactisch kapotte inline scripts.
# Installatie: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
cd "$(git rev-parse --show-toplevel)"
if [ -f scripts/check-js.sh ]; then
  ./scripts/check-js.sh || {
    echo ""
    echo "COMMIT GEWEIGERD: de JS-syntaxcontrole faalde."
    echo "Los de fouten hierboven op en probeer opnieuw."
    exit 1
  }
fi
